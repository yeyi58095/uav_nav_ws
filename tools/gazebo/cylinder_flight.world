    <!-- Navigation geometry: the collision and the painted shell share radius 2 m. -->
    <model name="test_cylinder">
      <static>true</static><pose>10 0 0 0 0 0</pose>
      <link name="column">
        <collision name="shell"><pose>0 0 4 0 0 0</pose><geometry><cylinder><radius>2</radius><length>8</length></cylinder></geometry></collision>
        <visual name="painted_steel">
          <pose>0 0 4 0 0 0</pose><geometry><cylinder><radius>2</radius><length>8</length></cylinder></geometry>
          <material><ambient>0.78 0.31 0.15 1</ambient><diffuse>0.78 0.31 0.15 1</diffuse><specular>0.08 0.08 0.08 1</specular></material>
        </visual>
        <visual name="foot">
          <pose>0 0 0.18 0 0 1.57079632679</pose><geometry><cylinder><radius>2.008</radius><length>0.34</length></cylinder></geometry>
          <material><ambient>0.45 0.21 0.15 1</ambient><diffuse>0.45 0.21 0.15 1</diffuse><specular>0.08 0.08 0.08 1</specular></material>
        </visual>
        <visual name="upper_band">
          <pose>0 0 6.62 0 0 0</pose><geometry><cylinder><radius>2.008</radius><length>0.58</length></cylinder></geometry>
          <material><ambient>0.91 0.89 0.81 1</ambient><diffuse>0.91 0.89 0.81 1</diffuse><specular>0.08 0.08 0.08 1</specular></material>
        </visual>
        <visual name="thin_band">
          <pose>0 0 7.22 0 0 0</pose><geometry><cylinder><radius>2.008</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.91 0.89 0.81 1</ambient><diffuse>0.91 0.89 0.81 1</diffuse><specular>0.08 0.08 0.08 1</specular></material>
        </visual>
        <visual name="top_rim">
          <pose>0 0 7.93 0 0 0</pose><geometry><cylinder><radius>2.008</radius><length>0.13</length></cylinder></geometry>
          <material><ambient>0.45 0.21 0.15 1</ambient><diffuse>0.45 0.21 0.15 1</diffuse><specular>0.08 0.08 0.08 1</specular></material>
        </visual>
        <visual name="steel_lid">
          <pose>0 0 8.012 0 0 0</pose><geometry><cylinder><radius>1.9</radius><length>0.023</length></cylinder></geometry>
          <material><ambient>0.30 0.34 0.34 1</ambient><diffuse>0.30 0.34 0.34 1</diffuse><specular>0.08 0.08 0.08 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- The project's prepared local model contains the ArduPilot physics plugin. -->
    <include>
      <uri>model://iris_with_ardupilot</uri>
      <pose>0 0 0.18 0 0 1.57079632679</pose>
    </include>

    <!-- The north-side camera keeps the aircraft visible during the recorded northern detour. -->
    <model name="viewpoint">
      <static>true</static>
      <pose>11.8 23 13 0 0.414 -1.649</pose>
      <link name="mount">
        <sensor name="camera" type="camera">
          <always_on>true</always_on><update_rate>25</update_rate><visualize>false</visualize>
          <camera name="tracking_view">
            <horizontal_fov>1.12</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>180</far></clip>
          </camera>
          <plugin name="range_camera" filename="libgazebo_ros_camera.so">
            <ros><namespace>/replay</namespace></ros>
            <camera_name>camera</camera_name>
            <frame_name>viewpoint_optical</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
    <plugin name="range_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>25</update_rate>
    </plugin>
    <gui fullscreen="0">
      <camera name="main_view"><pose>11.8 23 13 0 0.414 -1.649</pose><view_controller>orbit</view_controller></camera>
    </gui>
  </world>
</sdf>
